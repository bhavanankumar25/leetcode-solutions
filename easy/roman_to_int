class Solution:
    def romanToInt(self, s):
        roman = {'I':1,'V':5,'X':10,'L':50,'C':100,'D':500,'M':1000}
        total = 0
        for i in range(len(s)):
            curr=roman[s[i]]
            if i +1 <len(s) :
                next_val = roman[s[i+1]]
            else:
                 next_val = 0
            if curr < next_val: 
                total -= curr 
            else:
                total += curr
        return total
    
#add values left to right: VII=5+1+1=7, hence use total
#if smaller val appears before a larger val,subtract: IV = 5-1 = 4, IX = 10-1 = 9
#curr < next_val - subtract
#curr > next_val - add